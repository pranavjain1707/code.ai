
# Supabase database & auth settings
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# FastAPI application settings
JWT_SECRET=your_jwt_secret_for_sessions_here
APP_NAME="OpenRouter AI Chatbot"
DEBUG=True
PORT=8000

# Redis Cache URL (optional, falls back to mock memory if empty/invalid)
REDIS_URL=redis://localhost:6379/0

# Docker Model Runner settings (Local OpenAI-compatible API)
DOCKER_MODEL_RUNNER_URL=http://localhost:12434/v1

# OpenRouter settings (for cloud deployment, optional)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

